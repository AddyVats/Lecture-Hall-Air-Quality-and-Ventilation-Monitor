# Lecture Hall Air Quality Monitor - Environment Variables
# Copy this file to .env.local and fill in your values

# OpenAQ API Key (optional but recommended for higher rate limits)
# Get your free API key at https://openaq.org/api
OPENAQ_API_KEY=your_openaq_api_key_here

# Optional: WAQI/AQICN API Key (alternative data source)
# Get your token at https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=your_waqi_token_here

# Optional: Custom API endpoint for your own sensor gateway
# SENSOR_API_URL=https://your-sensor-gateway.com/api

# Optional: Webhook URL for alerts (e.g., Slack, Discord, custom endpoint)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Optional: Email notification settings (if using a service like SendGrid/Resend)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
ALERT_EMAIL_FROM=alerts@yourdomain.com
ALERT_EMAIL_TO=admin@yourdomain.com

# Application settings
NEXT_PUBLIC_APP_NAME="Lecture Hall AQ Monitor"
NEXT_PUBLIC_REFRESH_INTERVAL=60000
NEXT_PUBLIC_DEFAULT_TIME_RANGE=24h

# Feature flags
NEXT_PUBLIC_ENABLE_VENTILATION_CONTROL=true
NEXT_PUBLIC_ENABLE_HISTORICAL_CHARTS=true
NEXT_PUBLIC_ENABLE_MULTI_HALL=true